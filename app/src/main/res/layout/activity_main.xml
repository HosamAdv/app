<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D0D">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BudgetLock"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="المصروف: 0 / 0 ريال"
            android:textSize="18sp"
            android:textColor="#CCCCCC"
            android:gravity="center"
            android:layout_marginBottom="32dp"
            android:padding="16dp"
            android:background="#1A1A1A"/>

        <EditText
            android:id="@+id/etLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="الحد اليومي (ريال)"
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="#1A1A1A"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnSetLimit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تحديد الحد اليومي"
            android:backgroundTint="#2196F3"
            android:layout_marginBottom="24dp"/>

        <EditText
            android:id="@+id/etExpense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="أضف مصروف (ريال)"
            android:inputType="numberDecimal"
            android:textColor="#FFFFFF"
            android:textColorHint="#666666"
            android:background="#1A1A1A"
            android:padding="12dp"
            android:layout_marginBottom="8dp"/>

        <Button
            android:id="@+id/btnAddExpense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إضافة مصروف"
            android:backgroundTint="#4CAF50"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnReset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="إعادة تعيين"
            android:backgroundTint="#FF5722"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnAccessibility"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="تفعيل خدمة إمكانية الوصول"
            android:backgroundTint="#9C27B0"/>

    </LinearLayout>
</ScrollView>